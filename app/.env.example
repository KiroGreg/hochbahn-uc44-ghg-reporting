# Template for the gitignored `app/.env` — the OVERRIDE layer.
#
# Committed defaults live in `.env.defaults` and are always loaded first; this
# `.env` is loaded on top and only needs the keys you want to CHANGE from those
# defaults (typically: real secrets and `UC44_ENV=vm`).
#
# `.env` is git-ignored and never overwritten by `git pull`, so the VM keeps
# its own config across deploys. On the VM:
#   cp .env.example .env   &&  edit it  &&  \
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- Environment marker -------------------------------------------------------
# Tells the app it is running on the VM (vs. the `local` default). Surfaced at
# GET /api/health and logged on startup.
UC44_ENV=vm

# --- AUTH (required for any non-local deploy) ---------------------------------
# Shared bearer token. Anyone who knows it can use the app. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UC44_AUTH_TOKEN=

# --- LLM keys -----------------------------------------------------------------
# Both models default to OpenAI gpt-4o-mini.
OPENAI_API_KEY=

# --- Host ports ---------------------------------------------------------------
# Host port the frontend is exposed on. The prod overlay already rebinds to
# 80/443, so you usually do NOT need to set this on the VM.
# FRONTEND_PORT=8080

# --- Database -----------------------------------------------------------------
# Defaults (uc44/uc44/uc44) come from .env.defaults. For a real deploy, change
# the password here AND keep DATABASE_URL in sync. Data persists in the `pgdata`
# named volume.
# POSTGRES_USER=uc44
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=uc44
# DATABASE_URL=postgresql+psycopg://uc44:change-me@db:5432/uc44
