# Committed local defaults — loaded by docker-compose for EVERY environment.
#
# These are safe, non-secret values that make `docker compose up` work out of
# the box on a developer laptop. They are intentionally committed so a fresh
# clone runs with zero setup.
#
# How layering works (see docker-compose.yml `env_file:`):
#   1. .env.defaults   ← this file (committed, always loaded)
#   2. .env            ← gitignored, OPTIONAL override loaded on top
#
# On the VM, put the real secrets/overrides in a gitignored `app/.env`
# (template: .env.example). Because `.env` is untracked, `git pull` never
# overwrites it — the VM keeps its own config across deploys. Any key set
# there wins over the default below.

# Which environment am I? Overridden to `vm` in the VM's gitignored .env.
UC44_ENV=local

# --- Database (bundled Postgres service `db`) --------------------------------
POSTGRES_USER=uc44
POSTGRES_PASSWORD=uc44
POSTGRES_DB=uc44
# SQLAlchemy URL the backend uses inside the compose network. Keep user/pass/db
# in sync with the POSTGRES_* values above (or override all four in .env).
DATABASE_URL=postgresql+psycopg://uc44:uc44@db:5432/uc44

# --- Auth --------------------------------------------------------------------
# Empty = open API. Fine for local. On the VM, set a real token in .env.
UC44_AUTH_TOKEN=

# --- LLM ---------------------------------------------------------------------
# Left blank here (secret). Locally the models read `Use Case/models/.env`
# baked into the backend image. On the VM, set OPENAI_API_KEY in .env.
OPENAI_API_KEY=
